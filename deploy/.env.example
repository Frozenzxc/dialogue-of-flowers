# Копировать в .env рядом с docker-compose.yml и заполнить.
# Секреты генерируются так: openssl rand -base64 32
# (APP_KEYS — 4 значения через запятую, каждое своей командой)

# === Postgres ===
# Пароль только из букв/цифр (без + / =): он подставляется в DATABASE_URL
# Генерация: openssl rand -hex 18
POSTGRES_USER=strapi
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=strapi

# === Strapi ===
HOST=0.0.0.0
PORT=1337
# публичный адрес Strapi (домен в punycode + префикс /cms).
# Используется и при сборке образа (префикс админки), и в рантайме —
# после смены значения нужен docker compose build strapi
PUBLIC_URL=https://xn--80aeacdjrz1ad7b6b.xn--p1ai/cms

APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=CHANGE_ME
ADMIN_JWT_SECRET=CHANGE_ME
TRANSFER_TOKEN_SALT=CHANGE_ME
JWT_SECRET=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME

# === Сборка фронтенда ===
# относительный путь API: nginx проксирует /cms -> strapi:1337
STRAPI_API_URL=/cms
YANDEX_METRIKA_ID=103571975
